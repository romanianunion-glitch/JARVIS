# JARVIS application
JARVIS_NAME=Dum-E

# Open WebUI
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.12.5
WEBUI_CONTAINER=open-webui
WEBUI_HOST_IP=127.0.0.1
WEBUI_HOST_PORT=3000
WEBUI_VOLUME=open-webui

# External PWA manifest (optional; use the platform-specific URL from the install guide)
EXTERNAL_PWA_MANIFEST_URL=

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
